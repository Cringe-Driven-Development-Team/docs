{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/codex-modules-hook.ts\"",
            "timeout": 30,
            "statusMessage": "Проверка модулей"
          }
        ]
      }
    ]
  }
}
