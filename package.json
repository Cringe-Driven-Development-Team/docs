{
  "name": "docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc",
    "validate": "bun scripts/eraser.ts validate",
    "check": "bun scripts/check-colors.ts",
    "render": "bun scripts/docker.ts render",
    "render:native": "bun scripts/eraser.ts render -f html && bun scripts/eraser.ts render -f png",
    "index": "bun scripts/build-index.ts",
    "mermaid": "bun scripts/check-mermaid.ts",
    "site:dev": "vitepress dev site",
    "site:vitepress": "bun scripts/build-vitepress.ts",
    "site:check": "bun scripts/check-site.ts",
    "warm": "bun scripts/warm-icons.ts",
    "build": "bun scripts/docker.ts build",
    "build:native": "bun run validate && bun run check && bun run warm && bun run render:native && bun run index && bun run mermaid && bun run site:vitepress && bun run site:check",
    "site": "bun scripts/docker.ts site",
    "site:native": "bun scripts/build-site.ts",
    "icons": "bun scripts/fetch-icons.ts"
  },
  "devDependencies": {
    "@eraserlabs/diagrams-cli": "0.1.0",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@panzoom/panzoom": "4.6.2",
    "@types/bun": "1.4.2",
    "force-graph": "1.51.4",
    "gray-matter": "4.0.3",
    "mermaid": "^11",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
